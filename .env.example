# AI Monitoring Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
ENVIRONMENT=development    # development | production
DEBUG=false
RELOAD=true                # Hot reload in dev — set false in prod

# ── Database ──────────────────────────────────────
DB_PATH=monitoring.db      # Use /data/monitoring.db in Docker
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_monitor

# ── Traffic Simulation ────────────────────────────
# Set to "false" in production when real model endpoints are wired up
SIMULATE_TRAFFIC=true
SIMULATION_INTERVAL=2      # seconds between simulated inference batches

# ── Monitoring Intervals ──────────────────────────
METRICS_INTERVAL=5         # seconds between system metrics snapshots
ANOMALY_INTERVAL=30        # seconds between anomaly detection runs

# ── Alert Thresholds ──────────────────────────────
THRESHOLD_LATENCY_WARNING_MS=300
THRESHOLD_LATENCY_CRITICAL_MS=500
THRESHOLD_ERROR_RATE_WARNING=5.0
THRESHOLD_ERROR_RATE_CRITICAL=10.0
THRESHOLD_CPU_WARNING=75.0
THRESHOLD_CPU_CRITICAL=90.0
THRESHOLD_RAM_WARNING=80.0
THRESHOLD_RAM_CRITICAL=90.0
THRESHOLD_DRIFT_WARNING=0.1
THRESHOLD_DRIFT_CRITICAL=0.2
THRESHOLD_ZSCORE=2.5

# ── Slack Alerts ──────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Email Alerts (SMTP) ───────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL=team@yourcompany.com

# ── Telegram Alerts ───────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100123456789
